# Names only. Values live in Vercel (Preview and Production) and in your local .env.local.
NEXT_PUBLIC_SITE_URL=

# Gym profile id from src/profiles/ (default: aare-boxing-club)
GYM_PROFILE=

# Email (Resend). Without these, a fake sender records messages instead.
RESEND_API_KEY=
EMAIL_FROM=
CONTACT_EMAIL_TO=

# Auth (Supabase), added in the accounts use case
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Payments (Stripe), added in the memberships use case
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
